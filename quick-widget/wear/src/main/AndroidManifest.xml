<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-feature android:name="android.hardware.type.watch"/>
 <uses-permission android:name="android.permission.VIBRATE"/>
 <application android:allowBackup="true" android:label="MDS Log" android:icon="@drawable/ic_log"
  android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
  <uses-library android:name="com.google.android.wearable" android:required="false"/>
  <!-- Needs the MDS Quick Log phone app to pass days on to the timesheet. -->
  <meta-data android:name="com.google.android.wearable.standalone" android:value="false"/>
  <activity android:name=".WatchActivity" android:exported="true" android:taskAffinity="">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <service android:name=".LogTileService" android:exported="true" android:label="MDS Log"
   android:icon="@drawable/ic_log" android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
   <intent-filter><action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER"/></intent-filter>
   <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/ic_log"/>
  </service>
 </application>
</manifest>
