<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MDS QUICK LOG" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
  <Button android:id="@+id/resetJob" android:layout_width="wrap_content" android:layout_height="40dp" android:text="RESET" android:textSize="9sp"/>
 </LinearLayout>
 <TextView android:id="@+id/job" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JOB: TAP TO SET" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Jak • Test mode" android:textColor="#AEB4BA" android:textSize="11sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
  <Button android:id="@+id/start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="START" android:textSize="9sp"/>
  <Button android:id="@+id/onSite" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ON SITE" android:textSize="9sp"/>
  <Button android:id="@+id/offSite" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="OFF SITE" android:textSize="9sp"/>
  <Button android:id="@+id/finish" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="FINISH" android:textSize="9sp"/>
 </LinearLayout>
 <Button android:id="@+id/quickLog" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:text="⚡ QUICK LOG NOW" android:textStyle="bold" android:textSize="11sp"/>
</LinearLayout>
